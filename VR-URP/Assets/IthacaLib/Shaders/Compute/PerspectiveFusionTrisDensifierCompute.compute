RWTexture2D<float4> ColMapOut; //keep it for debug
RWTexture2D<uint> DepthMap;

Texture2D<float4> PosMapRead;
Texture2D<float4> ColMapRead;

float4 O;
float4 X;
float4 Y;
float4 Z;
//float4 bBoxPivot;
float4 camPos;

float4x4 bBoxMat;

int orthoWidth;
int orthoHeight;
int orthoDepth;

int depthThrsld;
float scalarNormalLimit;
bool FlipNormalsComparator;
bool Fusion;// in opposition to is preparing to fusion
bool voxelized;

int DebugPixelWidth;
int DebugPixelHeight;
int Thickness;
//bool startNewFusion;




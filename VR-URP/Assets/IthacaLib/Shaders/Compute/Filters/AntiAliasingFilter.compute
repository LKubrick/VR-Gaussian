#pragma kernel CSMain

RWTexture2D<float4> PosMapOut; // Output position map
RWTexture2D<float4> ColMapOut; // Output color map

Texture2D<float4> PosMapRead; // Input position map
Texture2D<float4> ColMapRead; // Input color map

float depththrshld;
int thickness; 
int blurDensity; 
float smoothingFactor; 
bool depthOnly;

[numthreads(8, 8, 1)]
void CSMain(uint2 id : SV_DispatchThreadID)
{
    float4 centerColor = ColMapRead[id];
    float4 centerPosition = PosMapRead[id];

 
    bool isEdge = false;
    
    
    if (thickness >=0)
    {
        for (int i = -thickness; i <= thickness; i++)
        {
            for (int j = -thickness; j <= thickness; j++)
            {
                if (i == 0 && j == 0)
                    continue;

                uint2 neighborCoord = id + int2(i, j);
                if (neighborCoord.x < 0 || neighborCoord.y < 0)
                    continue; 

                float neighborDepth = PosMapRead[neighborCoord].z;
                if (abs(centerPosition.z - neighborDepth) > depththrshld)
                {
                    isEdge = true;
                    break;
                }
            }
            if (isEdge)
                break;
        }
    }


    if (!isEdge)
    {
        ColMapOut[id] = centerColor;
        PosMapOut[id] = centerPosition;
        return;
    }


    float4 colorSum = float4(0, 0, 0, 0);
    float4 positionSum = float4(0, 0, 0, 0);
    float totalWeight = 0.0;

    for (int t = -blurDensity; t <= blurDensity; t++)
    {
        for (int u = -blurDensity; u <= blurDensity; u++)
        {
   
            uint2 sampleCoord = id + int2(t, u);
            if (sampleCoord.x < 0 || sampleCoord.y < 0)
                continue;

            float4 sampleColor = ColMapRead[sampleCoord];
            float4 samplePosition = PosMapRead[sampleCoord];

     
            if (samplePosition.z == 0)
                continue;

  
            float distance = length(float2(t, u));
            float weight = exp(-distance * smoothingFactor);

            colorSum += sampleColor * weight;
            positionSum += samplePosition * weight;
            totalWeight += weight;
        }
    }


    if (totalWeight > 0)
    {
        if (!depthOnly)
        {
            ColMapOut[id] = float4(colorSum.xyz / totalWeight, 1);

        }
        else
        {
            ColMapOut[id] = centerColor;
        }
            
        
        PosMapOut[id] = float4(positionSum.xyz / totalWeight, 1);
    }
    else
    {
        ColMapOut[id] = centerColor;

        PosMapOut[id] = centerPosition;
    }
}

